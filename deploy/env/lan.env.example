# LAN: https://<LAN_ADDRESS> from tablets on the same network.
# Copy to deploy/env/lan.env and set LAN_ADDRESS to the IP that tablets use to reach this
# machine. Each device must trust the local CA once: http://<LAN_ADDRESS>:8081/ca.crt (README).
LAN_ADDRESS=192.168.1.50
# Optionally add a hostname as well, e.g. SITE_ADDRESS=${LAN_ADDRESS}, drawthing.local
SITE_ADDRESS=${LAN_ADDRESS}
CADDY_DEFAULT_SNI=${LAN_ADDRESS}
CADDY_TLS=tls internal
APP_BIND=0.0.0.0
APP_HTTP_PORT=80
APP_HTTPS_PORT=443
APP_CA_BIND=0.0.0.0
APP_CA_PORT=8081
