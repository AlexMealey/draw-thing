# Cloud VM: https://<SITE_ADDRESS> with an automatic Let's Encrypt certificate.
# Copy to deploy/env/cloud.env. Point the DNS name at the VM and open ports 80 and 443.
SITE_ADDRESS=draw.example.com
APP_BIND=0.0.0.0
APP_HTTP_PORT=80
APP_HTTPS_PORT=443

# Managed container platforms that terminate TLS themselves (Cloud Run, Fly.io, Render,
# Azure Container Apps, ...) don't use compose: deploy the "runtime" image and set
# SITE_ADDRESS=:8080 (or whatever port the platform routes to).
